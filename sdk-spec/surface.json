{
  "$auditedAgainst": "141 routes carry @AllowApiKey() in apps/api, verified 2026-10-12 by decorator-block parse AND by a reader of the controllers. Two entries here were wrong on the first pass: GET /v1/teams has no @AllowApiKey (the decorator belongs to /teams/{id}/members below it) and GET /v1/agents has no handler at all (the agents controller serves only /agents/skills). Both would have 403ed and 404ed in ten SDKs. If you add an entry, prove the route is key-accessible by reading the handler, not by a nearest-decorator grep.",
  "$comment": "SINGLE SOURCE OF TRUTH for every Chatly backend SDK. scripts/check-sdk-surface-parity.mjs reads this file and fails if any SDK is missing an entry. Adding a method means adding it HERE first, then in every SDK. Every path below is key-accessible: it carries @AllowApiKey() in apps/api. A route that does not is not SDK surface, because a `ck_` key gets 403 from it.",
  "version": 1,
  "baseUrl": "https://api.chatlychat.com",
  "auth": {
    "scheme": "bearer",
    "header": "authorization",
    "prefix": "Bearer ",
    "credential": "ck_ workspace API key"
  },
  "entries": [
    { "ns": "root", "name": "whoami", "http": "GET", "path": "/v1/api-keys/whoami" },

    { "ns": "contacts", "name": "list", "http": "GET", "path": "/v1/contacts", "paged": true },
    { "ns": "contacts", "name": "get", "http": "GET", "path": "/v1/contacts/{id}" },
    { "ns": "contacts", "name": "upsert", "http": "POST", "path": "/v1/contacts", "write": true },
    {
      "ns": "contacts",
      "name": "bulk_upsert",
      "http": "POST",
      "path": "/v1/contacts/bulk",
      "write": true
    },
    {
      "ns": "contacts",
      "name": "merge",
      "http": "POST",
      "path": "/v1/contacts/{id}/merge",
      "write": true
    },
    {
      "ns": "contacts",
      "name": "add_tags",
      "http": "POST",
      "path": "/v1/contacts/{id}/tags",
      "write": true
    },
    {
      "ns": "contacts",
      "name": "remove_tag",
      "http": "DELETE",
      "path": "/v1/contacts/{id}/tags/{tag}",
      "write": true
    },
    {
      "ns": "contacts",
      "name": "unsubscribe",
      "http": "POST",
      "path": "/v1/contacts/{id}/unsubscribe",
      "write": true
    },
    { "ns": "contacts", "name": "journey", "http": "GET", "path": "/v1/contacts/{id}/journey" },

    {
      "ns": "conversations",
      "name": "list",
      "http": "GET",
      "path": "/v1/conversations",
      "paged": true
    },
    { "ns": "conversations", "name": "get", "http": "GET", "path": "/v1/conversations/{id}" },
    {
      "ns": "conversations",
      "name": "messages",
      "http": "GET",
      "path": "/v1/conversations/{id}/messages",
      "paged": true
    },
    {
      "ns": "conversations",
      "name": "send",
      "http": "POST",
      "path": "/v1/conversations/{id}/messages",
      "write": true
    },
    {
      "ns": "conversations",
      "name": "unattended",
      "http": "GET",
      "path": "/v1/conversations/unattended"
    },
    {
      "ns": "conversations",
      "name": "agent_handling",
      "http": "GET",
      "path": "/v1/conversations/{id}/agent-handling"
    },
    {
      "ns": "conversations",
      "name": "set_agent_handling",
      "http": "PUT",
      "path": "/v1/conversations/{id}/agent-handling",
      "write": true
    },
    {
      "ns": "conversations",
      "name": "generated_replies",
      "http": "GET",
      "path": "/v1/conversations/{id}/generated-replies"
    },
    {
      "ns": "conversations",
      "name": "generate_reply",
      "http": "POST",
      "path": "/v1/conversations/{id}/generated-replies",
      "write": true
    },
    {
      "ns": "conversations",
      "name": "scheduled_messages",
      "http": "GET",
      "path": "/v1/conversations/{id}/scheduled-messages"
    },
    {
      "ns": "conversations",
      "name": "schedule_message",
      "http": "POST",
      "path": "/v1/conversations/{id}/scheduled-messages",
      "write": true
    },
    {
      "ns": "conversations",
      "name": "cancel_scheduled",
      "http": "DELETE",
      "path": "/v1/conversations/scheduled-messages/{scheduled_id}",
      "write": true
    },

    { "ns": "tickets", "name": "list", "http": "GET", "path": "/v1/tickets", "paged": true },
    { "ns": "tickets", "name": "comments", "http": "GET", "path": "/v1/tickets/{id}/comments" },
    {
      "ns": "tickets",
      "name": "for_conversation",
      "http": "GET",
      "path": "/v1/tickets/for-conversation/{conversation_id}"
    },
    { "ns": "tickets", "name": "queues", "http": "GET", "path": "/v1/tickets/queues" },
    {
      "ns": "tickets",
      "name": "merge",
      "http": "POST",
      "path": "/v1/tickets/{id}/merge",
      "write": true
    },
    {
      "ns": "tickets",
      "name": "split",
      "http": "POST",
      "path": "/v1/tickets/{id}/split",
      "write": true
    },
    { "ns": "tickets", "name": "bulk", "http": "POST", "path": "/v1/tickets/bulk", "write": true },

    {
      "ns": "macros",
      "name": "list",
      "http": "GET",
      "path": "/v1/macros",
      "$note": "NOT paged: the handler carries @PaginationExempt and returns a bare array capped at 200, ordered by usage rank. This said `paged: true` for a day, and the .NET and Rust clients both raised a decode error on it while their surface-lock suites stayed green — their fake transports answer every route with a page envelope."
    },
    { "ns": "macros", "name": "create", "http": "POST", "path": "/v1/macros", "write": true },
    { "ns": "macros", "name": "update", "http": "PATCH", "path": "/v1/macros/{id}", "write": true },
    {
      "ns": "macros",
      "name": "delete",
      "http": "DELETE",
      "path": "/v1/macros/{id}",
      "write": true
    },

    { "ns": "kb", "name": "articles", "http": "GET", "path": "/v1/kb/articles", "paged": true },
    { "ns": "kb", "name": "article", "http": "GET", "path": "/v1/kb/articles/{slug}" },
    { "ns": "kb", "name": "collections", "http": "GET", "path": "/v1/kb/collections" },

    { "ns": "search", "name": "query", "http": "GET", "path": "/v1/search" },

    { "ns": "events", "name": "track", "http": "POST", "path": "/v1/cdp/events", "write": true },
    { "ns": "events", "name": "list", "http": "GET", "path": "/v1/cdp/events", "paged": true },

    {
      "ns": "webhooks",
      "name": "deliveries",
      "http": "GET",
      "path": "/v1/webhooks/deliveries",
      "paged": true
    },
    { "ns": "webhooks", "name": "delivery", "http": "GET", "path": "/v1/webhooks/deliveries/{id}" },
    {
      "ns": "webhooks",
      "name": "redeliver",
      "http": "POST",
      "path": "/v1/webhooks/deliveries/{id}/redeliver",
      "write": true
    },

    { "ns": "reports", "name": "overview", "http": "GET", "path": "/v1/reports/overview" },
    { "ns": "reports", "name": "agents", "http": "GET", "path": "/v1/reports/agents" },
    {
      "ns": "reports",
      "name": "conversations_by_day",
      "http": "GET",
      "path": "/v1/reports/conversations-by-day"
    },
    { "ns": "reports", "name": "sla", "http": "GET", "path": "/v1/reports/sla" },

    { "ns": "channels", "name": "list", "http": "GET", "path": "/v1/channels" },
    { "ns": "channels", "name": "get", "http": "GET", "path": "/v1/channels/{id}" },

    { "ns": "billing", "name": "plans", "http": "GET", "path": "/v1/billing/plans" },
    {
      "ns": "billing",
      "name": "usage",
      "http": "GET",
      "path": "/v1/billing/usage",
      "$requires": "eventType — the handler validates it against a closed list and throws before doing anything else, so a call with no query is a 400. Four SDKs shipped it as an optional argument."
    },

    { "ns": "workspace", "name": "settings", "http": "GET", "path": "/v1/workspace/settings" },
    { "ns": "workspace", "name": "labels", "http": "GET", "path": "/v1/labels" },
    { "ns": "workspace", "name": "inboxes", "http": "GET", "path": "/v1/inboxes" },
    { "ns": "workspace", "name": "team_members", "http": "GET", "path": "/v1/teams/{id}/members" },
    { "ns": "workspace", "name": "agent_skills", "http": "GET", "path": "/v1/agents/skills" }
  ],
  "helpers": [
    {
      "name": "verify_webhook_signature",
      "what": "HMAC-SHA256 over `<t>.<raw body>`, constant-time compare, 300s default tolerance"
    },
    {
      "name": "identity_hash",
      "what": "HMAC-SHA256 hex of externalId under the workspace identity-verification secret"
    }
  ]
}
